# General
NODE_ENV=production

# Backend server
BC_PORT=4002
BC_HTTPS=false
BC_PRIVATE_KEY=/etc/ssl/bookcars.key
BC_CERTIFICATE=/etc/ssl/bookcars.crt

# MongoDB
BC_DB_URI="mongodb://admin:PASSWORD@mongo:27017/bookcars?authSource=admin&appName=bookcars"
BC_DB_SSL=false
BC_DB_SSL_CERT=/etc/ssl/bookcars.crt
BC_DB_SSL_CA=/etc/ssl/bookcars.ca.pem
BC_DB_DEBUG=false

# Auth
BC_COOKIE_SECRET=COOKIE_SECRET
BC_AUTH_COOKIE_DOMAIN=localhost
BC_ADMIN_HOST=http://localhost:3001/ # very important, otherwise admin auth won't work
BC_FRONTEND_HOST=http://localhost:8080/ # very important, otherwise frontend auth won't work
BC_JWT_SECRET=JWT_SECRET
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400

# Email (SMTP)
BC_SMTP_HOST=smtp.sendgrid.net
BC_SMTP_PORT=587
BC_SMTP_USER=SMTP_USER
BC_SMTP_PASS="SMTP_PASSWORD"
BC_SMTP_FROM="MITOS Rent a Car <SMTP_USER>"

# CDN (File storage)
BC_CDN_ROOT=/var/www/cdn
BC_CDN_USERS=/var/www/cdn/bookcars/users
BC_CDN_TEMP_USERS=/var/www/cdn/bookcars/temp/users
BC_CDN_CARS=/var/www/cdn/bookcars/cars
BC_CDN_TEMP_CARS=/var/www/cdn/bookcars/temp/cars
BC_CDN_LOCATIONS=/var/www/cdn/bookcars/locations
BC_CDN_TEMP_LOCATIONS=/var/www/cdn/bookcars/temp/locations
BC_CDN_CONTRACTS=/var/www/cdn/bookcars/contracts
BC_CDN_TEMP_CONTRACTS=/var/www/cdn/bookcars/temp/contracts
BC_CDN_LICENSES=/var/www/cdn/bookcars/licenses
BC_CDN_TEMP_LICENSES=/var/www/cdn/bookcars/temp/licenses

# Localization / pricing authority
BC_DEFAULT_LANGUAGE=es
BC_BASE_CURRENCY=PEN

# Business Rules
BC_MINIMUM_AGE=21

# Expo
BC_EXPO_ACCESS_TOKEN=EXPO_ACCESS_TOKEN

# Stripe
BC_STRIPE_SECRET_KEY=STRIPE_SECRET_KEY
BC_STRIPE_SESSION_EXPIRE_AT=82800

# PayPal
BC_PAYPAL_SANDBOX=true
BC_PAYPAL_CLIENT_ID=PAYPAL_CLIENT_ID
BC_PAYPAL_CLIENT_SECRET=PAYPAL_CLIENT_SECRET

# Mercado Pago — never commit real values.
BC_MERCADO_PAGO_ACCESS_TOKEN=MERCADO_PAGO_ACCESS_TOKEN
BC_MERCADO_PAGO_WEBHOOK_SECRET=MERCADO_PAGO_WEBHOOK_SECRET
BC_MERCADO_PAGO_CURRENCY=PEN

# Admin
BC_ADMIN_EMAIL=ADMIN_EMAIL

# Explicit DEV fixture seed. Disabled by default; no source-code fallback.
MITOS_ENABLE_DEV_SEED=false
MITOS_ALLOW_SEED=false
MITOS_DEMO_PASSWORD=
MITOS_DEMO_CUSTOMER_EMAIL=
MITOS_DEMO_CUSTOMER_NAME=
MITOS_DEMO_ADMIN_EMAIL=
MITOS_DEMO_ADMIN_NAME=
MITOS_DEMO_SUPPLIER_EMAIL=

# Google reCAPTCHA
BC_RECAPTCHA_SECRET=RECAPTCHA_SECRET

# Misc
BC_WEBSITE_NAME=MITOS RENT A CAR
BC_TIMEZONE=America/Lima # Timezone for converting dates from UTC to local time (used in emails sent from backend).

# IPInfo (Geo lookup)
BC_IPINFO_API_KEY=IPINFO_API_KEY # Required for more than 1000 requests/day
BC_IPINFO_DEFAULT_COUNTRY=PE

# Language cleanup job
BC_BATCH_SIZE=1000 # Number of documents to process per batch when deleting obsolete language values
