# MITOS Railway runtime contract — example only. Never commit real secrets.
# Current free-tier topology is a single Railway service:
# nginx listens publicly on :4002 and proxies /api + /socket.io + /cdn to Node on :4003.
NODE_ENV=production
BC_PORT=4003
BC_HTTPS=false

# Product identity / locale / pricing authority
BC_WEBSITE_NAME=MITOS RENT A CAR
BC_DEFAULT_LANGUAGE=es
BC_TIMEZONE=America/Lima
BC_IPINFO_DEFAULT_COUNTRY=PE
BC_ADMIN_EMAIL=ADMIN_EMAIL
BC_BASE_CURRENCY=PEN

# Current same-origin browser topology.
# Customer is served at / and Admin at /admin/ on the same Railway host.
# Replace YOUR_RAILWAY_DOMAIN with the active Railway/custom domain.
BC_FRONTEND_HOST=https://YOUR_RAILWAY_DOMAIN
BC_ADMIN_HOST=https://YOUR_RAILWAY_DOMAIN/admin
# Host-only cookies are preferred for this same-origin test topology.
BC_AUTH_COOKIE_DOMAIN=

# Secrets / data authority
# Current Mitos authority is MongoDB Atlas logical database `mitos`.
BC_DB_URI=MONGODB_CONNECTION_STRING
BC_DB_SSL=false
BC_DB_DEBUG=false
BC_COOKIE_SECRET=GENERATE_A_LONG_RANDOM_SECRET
BC_JWT_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400

# CDN filesystem contract.
# WARNING: /data/cdn is NOT durable unless backed by a persistent Railway volume/storage adapter.
BC_CDN_ROOT=/data/cdn
BC_CDN_USERS=/data/cdn/bookcars/users
BC_CDN_TEMP_USERS=/data/cdn/bookcars/temp/users
BC_CDN_CARS=/data/cdn/bookcars/cars
BC_CDN_TEMP_CARS=/data/cdn/bookcars/temp/cars
BC_CDN_LOCATIONS=/data/cdn/bookcars/locations
BC_CDN_TEMP_LOCATIONS=/data/cdn/bookcars/temp/locations
BC_CDN_CONTRACTS=/data/cdn/bookcars/contracts
BC_CDN_TEMP_CONTRACTS=/data/cdn/bookcars/temp/contracts
BC_CDN_LICENSES=/data/cdn/bookcars/licenses
BC_CDN_TEMP_LICENSES=/data/cdn/bookcars/temp/licenses

# Email on Railway Hobby: use HTTPS because direct outbound SMTP is not available on this lane.
# MailerSend is the current Railway transport; SMTP/Nodemailer remains canonical/default for VPS.
BC_EMAIL_ENABLED=true
BC_EMAIL_PROVIDER=mailersend
BC_EMAIL_TIMEOUT_MS=10000
BC_MAILERSEND_API_KEY=MAILERSEND_API_KEY
BC_EMAIL_FROM="MITOS Rent a Car <sender@YOUR_MAILERSEND_AUTHORIZED_DOMAIN>"
BC_MAILERSEND_API_URL=https://api.mailersend.com/v1/email

# Previous HTTPS transport remains available in code, but is not current.
BC_RESEND_API_KEY=
BC_RESEND_API_URL=https://api.resend.com/emails

# SMTP/Nodemailer canonical VPS path.
# These values are not used while BC_EMAIL_PROVIDER=mailersend.
# A future VPS should switch back by changing only the provider selector plus valid SMTP credentials:
# BC_EMAIL_PROVIDER=smtp
BC_SMTP_HOST=smtp.gmail.com
BC_SMTP_PORT=587
BC_SMTP_SECURE=false
BC_SMTP_USER=SMTP_USER
BC_SMTP_PASS=SMTP_PASSWORD
BC_SMTP_FROM="MITOS Rent a Car <SMTP_USER>"

# DEV fixture seed is disabled on Railway by default. A remote fixture run
# requires BOTH opt-ins plus every identity/credential supplied explicitly.
MITOS_ENABLE_DEV_SEED=false
MITOS_ALLOW_SEED=false
MITOS_DEMO_PASSWORD=
MITOS_DEMO_CUSTOMER_EMAIL=
MITOS_DEMO_CUSTOMER_NAME=
MITOS_DEMO_ADMIN_EMAIL=
MITOS_DEMO_ADMIN_NAME=
MITOS_DEMO_SUPPLIER_EMAIL=

# Providers — configure only when that provider is being certified.
BC_STRIPE_SECRET_KEY=STRIPE_SECRET_KEY
BC_STRIPE_SESSION_EXPIRE_AT=82800
BC_PAYPAL_SANDBOX=true
BC_PAYPAL_CLIENT_ID=PAYPAL_CLIENT_ID
BC_PAYPAL_CLIENT_SECRET=PAYPAL_CLIENT_SECRET

# Mercado Pago. Access token and webhook secret are private backend-only values.
# MitoS rejects provider payments if the provider amount or currency differs
# from the server-recalculated booking charge.
BC_MERCADO_PAGO_ACCESS_TOKEN=MERCADO_PAGO_ACCESS_TOKEN
BC_MERCADO_PAGO_WEBHOOK_SECRET=MERCADO_PAGO_WEBHOOK_SECRET
BC_MERCADO_PAGO_CURRENCY=PEN

BC_RECAPTCHA_SECRET=RECAPTCHA_SECRET
BC_EXPO_ACCESS_TOKEN=
BC_IPINFO_API_KEY=

# Optional integrations remain disabled unless explicitly configured.
BC_ODOO_URL=
BC_ODOO_DB=
BC_ODOO_USERNAME=
BC_ODOO_PASSWORD=
BC_ENABLE_SENTRY=false
BC_BATCH_SIZE=1000
